# Configuration for the demo app (examples/demo). Copy to .env and fill in.
# Never commit .env.

# Required (unless you run with -dev): HS256 signing key, base64, >= 32 bytes.
#   openssl rand -base64 32
IAM_SIGNING_KEY=

# Optional: use PASETO access tokens instead of JWT (base64, 32 bytes).
IAM_PASETO_KEY=

# Optional: CSRF token key (base64, >= 32 bytes). Random per process if unset;
# set it when running more than one instance.
IAM_CSRF_KEY=

# Optional: seed an admin account (it can create invites).
IAM_ADMIN_EMAIL=
IAM_ADMIN_PASSWORD=

# Sign-up policy: invite-only by default; "open" lets anyone register.
IAM_SIGNUP=

# Comma-separated CIDRs of reverse proxies whose X-Forwarded-For is trusted.
IAM_TRUSTED_PROXIES=

# Optional: Google sign-in.
GOOGLE_OAUTH_CLIENTID=

PORT=8080
# Prometheus metrics listener (keep it private).
ADMIN_ADDR=127.0.0.1:9090
